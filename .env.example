# Supabase (optional - for persistence)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# X API v2 (optional, used first when provided)
# Get your bearer token from https://developer.x.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Google Analytics 4 (optional but recommended for launch tracking)
# Example: G-ABC123XYZ9
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga4_measurement_id

# Public site URL (recommended for correct social card URLs)
# Example: https://tweetmates.vercel.app
NEXT_PUBLIC_SITE_URL=your_public_site_url
